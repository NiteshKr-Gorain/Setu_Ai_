# Database URI
MONGO_URI=mongodb://localhost:27017

# Database name
MONGO_DB_NAME=knowledge_preservation_db

# JWT secret
JWT_SECRET_KEY=mysecretkeyforproject

# JWT algorithm
JWT_ALGORITHM=HS256

# Access expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh expiry
REFRESH_TOKEN_EXPIRE_DAYS=7

# Max upload
MAX_UPLOAD_SIZE_MB=100

# Upload directory
UPLOAD_DIR=uploads

# OpenAI key
OPENAI_API_KEY=your_openai_api_key_here

# Whisper model
WHISPER_MODEL=whisper-1

# Anthropic key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Summarization model
SUMMARIZATION_MODEL=claude-sonnet-4-6

# Processing attempts
MAX_PROCESSING_ATTEMPTS=3

# Processing timeout
PROCESSING_STALE_MINUTES=30

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Vector dimensions
EMBEDDING_DIMENSIONS=1536

# Atlas search
USE_ATLAS_VECTOR_SEARCH=False

# Index name
ATLAS_VECTOR_INDEX_NAME=knowledge_embedding_index

# Local limit
LOCAL_VECTOR_CANDIDATE_LIMIT=2000
